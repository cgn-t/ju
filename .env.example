# jumbo (uygulama) çalışma zamanı ortam değişkenleri — ./run.sh bunu okur.
# GERÇEK .env GİT'E GİRMEZ (.gitignore). Bu ŞABLON commit edilir (gerçek sır içermez).
#
# ./run.sh ilk çalışmada: çalışan bir 'jumbo' varsa secret'ları ondan alır (KORUR);
# yoksa JWT_SECRET/FERNET_KEY'i taze üretir ve MSSQL_PASSWORD'ü size bırakır.
# Elle hazırlamak isterseniz bu dosyayı .env olarak kopyalayıp doldurun.

# --- MSSQL bağlantısı ---
MSSQL_HOST=jumbo-mssql          # prod'da dış MSSQL host'u/IP'si
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_DB=JUMBOBP
MSSQL_PASSWORD=CHANGE_ME        # ⚠️ gerçek parola — yalnız .env'de tutun, ASLA commit etmeyin

# --- Uygulama sırları (recreate'te AYNI kalmalı) ---
# JWT_SECRET : oturum imzalama anahtarı. Değişirse tüm aktif oturumlar düşer.
# FERNET_KEY : DB'deki şifreli alanların (ör. entegrasyon token'ları) anahtarı.
#              Değişirse mevcut şifreli veri ARTIK OKUNAMAZ.
# Üretmek için:
#   JWT_SECRET=$(openssl rand -hex 32)
#   FERNET_KEY=$(openssl rand -base64 32 | tr '+/' '-_')
JWT_SECRET=CHANGE_ME
FERNET_KEY=CHANGE_ME
